{
  "name": "railmania",
  "productName": "Railmania",
  "version": "0.1.0",
  "description": "Railmania desktop game base",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.3.13",
  "trustedDependencies": [
    "electron"
  ],
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "check": "bun run check:main && bun run check:renderer",
    "check:main": "tsc --noEmit -p tsconfig.main.json",
    "check:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "build": "electron-forge package",
    "package": "electron-forge package",
    "install:ci": "bun ci",
    "deps:check": "bun outdated",
    "audit": "bun audit --audit-level=low",
    "smoke:package": "bun scripts/smoke-package.ts",
    "verify": "bun run check && bun run audit && bun run package"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.10",
    "@electron-forge/plugin-vite": "8.0.0-alpha.10",
    "@electron-forge/shared-types": "8.0.0-alpha.10",
    "@electron/fuses": "2.1.3",
    "@types/node": "26.2.0",
    "electron": "43.4.1",
    "javascript-obfuscator": "5.6.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
